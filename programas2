<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Radio Rambla - Programas</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<style>
:root{
  --bg:#0a0a0f;
  --card:#161622;
  --card-hover:#1c1c2a;
  --accent:#1db954; /* estilo Spotify */
  --text:#fff;
  --muted:#a0a0a0;
}

*{box-sizing:border-box}

body{
  margin:0;
  font-family:Inter, sans-serif;
  background: radial-gradient(circle at top, #1b1b2e, var(--bg));
  color:var(--text);
  padding-bottom:120px; /* espacio para player fijo */
}

/* HEADER */
header{
  padding:25px 20px;
  text-align:center;
}

header h1{
  margin:0;
  font-size:2rem;
}

header p{
  margin-top:6px;
  color:var(--muted);
}

/* LISTA */
.container{
  max-width:800px;
  margin:auto;
  padding:10px 15px;
  display:flex;
  flex-direction:column;
  gap:15px;
}

/* CARD */
.card{
  background:var(--card);
  padding:18px;
  border-radius:16px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  transition:.25s;
  cursor:pointer;
}

.card:hover{
  background:var(--card-hover);
  transform:translateY(-3px);
}

.card h3{
  margin:0;
  font-size:1rem;
}

.card span{
  color:var(--muted);
  font-size:0.85rem;
}

/* PLAY BUTTON */
.play{
  width:45px;
  height:45px;
  border-radius:50%;
  background:var(--accent);
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  color:#000;
  flex-shrink:0;
  box-shadow:0 8px 20px rgba(29,185,84,0.3);
}

/* PLAYER FIJO (tipo Spotify) */
.player{
  position:fixed;
  bottom:0;
  left:0;
  width:100%;
  background:#111;
  border-top:1px solid #222;
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:12px 15px;
  gap:10px;
}

.player-info{
  display:flex;
  flex-direction:column;
}

.player-info strong{
  font-size:0.9rem;
}

.player-info small{
  color:var(--muted);
}

audio{
  width:200px;
}

/* BOTÓN VOLVER */
.top-btn{
  text-align:center;
  margin-bottom:15px;
}

.top-btn a{
  display:inline-block;
  padding:10px 18px;
  background:rgba(255,255,255,0.08);
  border-radius:12px;
  color:#fff;
  text-decoration:none;
}

/* MOBILE */
@media(max-width:600px){
  audio{width:120px;}
}
</style>
</head>

<body>

<header>
  <h1>Radio Rambla</h1>
  <p>Programas grabados · estilo Spotify</p>
</header>

<div class="top-btn">
  <a href="index.html">🔴 Volver a directo</a>
</div>

<div class="container">

  <div class="card">
    <div>
      <h3>Sábado 30 Mayo 2026</h3>
      <span>Programa completo</span>
    </div>
    <div class="play">▶</div>
    <audio src="https://archive.org/download/grabacion-2026-05-30/grabacion-2026-05-30.mp3"></audio>
  </div>

  <div class="card">
    <div>
      <h3>Viernes 29 Mayo 2026</h3>
      <span>Programa completo</span>
    </div>
    <div class="play">▶</div>
    <audio src="https://archive.org/download/programa-2026-05-29/programa-2026-05-29.mp3"></audio>
  </div>

  <div class="card">
    <div>
      <h3>Jueves 28 Mayo 2026</h3>
      <span>Programa completo</span>
    </div>
    <div class="play">▶</div>
    <audio src="https://my.hidrive.com/api/sharelink/download?id=IpzsdoB8K"></audio>
  </div>

</div>

<!-- PLAYER FIJO -->
<div class="player">
  <div class="player-info">
    <strong id="title">Ningún programa</strong>
    <small>Radio Rambla</small>
  </div>

  <audio id="globalPlayer" controls></audio>
</div>

<script>
const cards = document.querySelectorAll(".card");
const globalPlayer = document.getElementById("globalPlayer");
const title = document.getElementById("title");

cards.forEach(card => {
  const audio = card.querySelector("audio");
  const btn = card.querySelector(".play");
  const name = card.querySelector("h3").innerText;

  btn.addEventListener("click", () => {
    globalPlayer.src = audio.src;
    globalPlayer.play();
    title.innerText = name;
  });
});
</script>

</body>
</html>
